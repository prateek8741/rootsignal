# Copy to .env and adjust. Never commit real keys.

# --- Server -------------------------------------------------------------------
# Local Homebrew PostgreSQL; see scripts/dev_setup.sh
ROOTSIGNAL_DATABASE_URL=postgresql+psycopg://localhost:5432/rootsignal_dev
# Integration tests drop and recreate the schema; the name must end in _test.
ROOTSIGNAL_TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/rootsignal_test

# Dashboard sessions. Set SECURE=true whenever the dashboard is served over HTTPS.
ROOTSIGNAL_SESSION_COOKIE_SECURE=false
ROOTSIGNAL_SESSION_ABSOLUTE_TTL_HOURS=12
ROOTSIGNAL_SESSION_IDLE_MINUTES=120
ROOTSIGNAL_LOGIN_LINK_TTL_MINUTES=5

# Platform LLM for investigations: none | ollama | openai_compatible.
# Projects also need llm_monthly_token_budget > 0. Non-local providers are refused
# unless ROOTSIGNAL_LLM_ALLOW_EXTERNAL=true (evidence is customer data).
ROOTSIGNAL_LLM_PROVIDER=none
ROOTSIGNAL_LLM_BASE_URL=http://127.0.0.1:11434
ROOTSIGNAL_LLM_MODEL=llama3.1:8b
ROOTSIGNAL_LLM_API_KEY=
ROOTSIGNAL_LLM_ALLOW_EXTERNAL=false

# --- SDK (in the instrumented agent's environment) -----------------------------
ROOTSIGNAL_ENDPOINT=http://127.0.0.1:8000
ROOTSIGNAL_API_KEY=
ROOTSIGNAL_SERVICE_NAME=support-agent
ROOTSIGNAL_ENVIRONMENT=development
ROOTSIGNAL_SAMPLE_RATE=1.0
ROOTSIGNAL_CAPTURE_PAYLOADS=true
# Off by default: the end user's request text is not recorded unless enabled.
ROOTSIGNAL_CAPTURE_USER_INPUT=false
ROOTSIGNAL_REDACT_PII=true
# Optional secret for HMAC-ing tool arguments (see docs/TRACE_SCHEMA.md).
ROOTSIGNAL_ARGS_HASH_KEY=
